# ── Firebase (client-side, already in firebase-config.js) ──
# These are public client-side keys, not secrets.
# FIREBASE_API_KEY=your-firebase-api-key
# FIREBASE_PROJECT_ID=riad-265a5

# ── Translation (Vercel serverless function: api/translate.js) ──
OPENROUTER_API_KEY=your-openrouter-api-key-here
ALLOWED_ORIGIN=https://qrcode-tsadki.vercel.app

# ── TURN Server (optional, for 4G/mobile/strict NAT) ──
# See README.md for free TURN providers.
# Set these and inject into call.html <meta> tags or window globals.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── server.js (local dev only, NOT used on Vercel) ──
# TKALAM_API_KEY=your-tkalam-key
